PORT=19000
NODE_ENV=production

# Database Connection Credentials
# DB_TYPE options: sqlite | postgresql | mysql
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=vending_user
DB_PASSWORD=secret_password
DB_NAME=vending_db
# Optional Direct Connection String Override
DATABASE_URL="mysql://user:password@localhost:3306/vending_db"

# EthSwitch / NBE Dynamic QR Configuration
ETH_GUID="581b314e257f41bfbbdc6384daa31d16"
ACQUIRER_BIC="CBETETAA"
MERCHANT_ACCOUNT="0000171234567890"
MERCHANT_NAME="AFen Smart Vending"
MERCHANT_CITY="ADDIS ABABA"
MCC="5999"
CURRENCY_CODE="586"
COUNTRY_CODE="ET"

# ---------------------------------------------------------------------------
# Telebirr (Fabric / SuperApp gateway)
# ---------------------------------------------------------------------------
# All values below are issued by Ethio Telecom when your merchant is onboarded.
# If any are missing the app still boots, but /api/payment/telebirr/initiate
# fails with the full list of what is absent.

# Gateway base. Note the non-standard port and the full path.
TELE_BASE_URL="https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway"

# Fabric layer - the API gateway sitting in front of the payment service.
# TELE_FABRIC_APP_ID is sent as the X-APP-Key header.
TELE_FABRIC_APP_ID=""
TELE_APP_SECRET=""

# Merchant identity - the payment service itself.
# WARNING: TELE_MERCHANT_APP_ID is NOT the same value as TELE_FABRIC_APP_ID.
# Swapping these two is the single most common integration mistake; it shows up
# as an opaque signature failure, not as an "unknown app" error.
TELE_MERCHANT_APP_ID=""
TELE_MERCHANT_CODE=""

# RSA keys. Bare base64 or full PEM both work - they are normalised in code.
# TELE_PRIVATE_KEY is your PKCS8 key and signs outbound requests.
# TELE_PUBLIC_KEY is Telebirr's key and verifies inbound callbacks. Optional,
# but without it every callback falls through to queryOrder (slower, safe).
TELE_PRIVATE_KEY=""
TELE_PUBLIC_KEY=""

# Callbacks. TELE_NOTIFY_URL must be publicly reachable over HTTPS - it is baked
# into each preOrder, and localhost gets you silence. Use ngrok in development.
TELE_NOTIFY_URL="https://your.host/api/webhooks/telebirr"
TELE_REDIRECT_URL="https://your.host/pay/telebirr/return"

# Transport
TELE_SSL_VERIFY=true
TELE_TIMEOUT_MS=30000

# Sandbox shortcuts (mock pay page + "Instant Sandbox Payment" button) mark
# orders PAID with no gateway involvement. Ignored when NODE_ENV=production.
TELE_ALLOW_SANDBOX_PAY=false
