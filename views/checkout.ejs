<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>
    <%= title || "TOMOCA Coffee" %>
  </title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap');

    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      background-color: #FAFAF9;
      color: #1C1917;
    }
  </style>
</head>

<body class="min-h-screen flex flex-col justify-between max-w-sm mx-auto px-4 py-8">
  <!-- Header: TOMOCA Logo & Title -->
  <header class="text-center pt-2 pb-4">
    <img src="/images/logo.jpg" class="h-10 mx-auto object-contain" alt="TOMOCA Coffee"
      onError="this.style.display='none'; document.getElementById('logoFallbackText').style.display='block';" />
    <div id="logoFallbackText" class="hidden font-bold text-lg text-stone-900 tracking-wide uppercase">
      TOMOCA COFFEE
    </div>
    <h1 class="mt-2 text-base font-black text-stone-900 tracking-widest uppercase">
      TOMOCA COFFEE
    </h1>
  </header>

  <!-- Main Card: Minimalist Selection & Price Readout -->
  <main class="my-auto space-y-6">
    <div class="bg-white rounded-2xl border border-stone-200 shadow-sm p-6 space-y-6 text-center">
      <!-- Item / Selection Badges Row -->
      <div class="flex items-center justify-center gap-2">
        <span class="px-3 py-1 bg-stone-100 border border-stone-200 text-stone-700 text-xs font-semibold rounded-full">
          Slot: <%= sid %>
        </span>
        <span class="px-3 py-1 bg-stone-100 border border-stone-200 text-stone-700 text-xs font-semibold rounded-full">
          Product: <%= pid %>
        </span>
      </div>

      <!-- Price Readout -->
      <div class="py-2">
        <div class="text-4xl font-black text-stone-900">
          <%= price %> <span class="text-lg font-semibold text-orange-600">ETB</span>
        </div>
      </div>

      <!-- Machine Label -->
      <div class="text-xs text-stone-500 font-medium">
        Dispenser #<%= mid %>
      </div>
    </div>

    <!-- Action Button Form -->
    <div class="space-y-3">
      <button id="payBtn" onclick="initiatePayment()"
        class="bg-orange-600 hover:bg-orange-700 text-white font-semibold py-4 rounded-xl shadow-md w-full active:scale-[0.99] transition flex items-center justify-center gap-2">
        <span id="payBtnText">Pay with Telebirr</span>
      </button>

      <!-- Sandbox Test Button - dev only, never rendered in production -->
      <% if (typeof sandbox !=='undefined' && sandbox) { %>
        <button onclick="simulateFastCheckout()"
          class="w-full py-2 text-xs font-medium text-stone-500 hover:text-stone-700 hover:bg-stone-100 rounded-lg transition-colors">
          Instant Sandbox Payment
        </button>
        <% } %>
    </div>
  </main>

  <!-- Bridge status. Visible while integrating so a device shows plainly
       whether telebirr injected its payment bridge. -->
  <div id="bridgeStatus" class="mx-auto mb-2 px-3 py-2 rounded-lg border text-center text-xs font-semibold bg-stone-100 border-stone-200 text-stone-500">
    checking telebirr bridge...
  </div>

  <!-- Minimal Footer -->
  <footer class="text-center text-xs text-stone-400 py-2">
    <p>TOMOCA Coffee © <%= new Date().getFullYear() %>
    </p>
  </footer>

  <!-- On-device console. Opt in with ?debug=1 - there is no devtools inside
       the SuperApp, so this is how you read errors from the bridge call. -->
  <script>
    if (location.search.indexOf('debug=1') !== -1) {
      var s = document.createElement('script');
      s.src = '/vconsole.min.js';
      s.onload = function () { new window.VConsole(); };
      document.head.appendChild(s);
    }
  </script>

  <script>
    const orderNo = "<%= orderNo %>";

    // Report the environment so a failed bridge is visible server side too,
    // and show the result on the page for whoever is holding the phone.
    (function () {
      var hasConsumerapp = typeof window.consumerapp !== 'undefined' && window.consumerapp !== null;
      var hasStartPay = typeof window.ma !== 'undefined' && window.ma && typeof window.ma.startPay === 'function';

      var el = document.getElementById('bridgeStatus');
      if (hasStartPay) {
        el.className = 'mx-auto mb-2 px-3 py-2 rounded-lg border text-center text-xs font-semibold bg-green-50 border-green-200 text-green-700';
        el.textContent = 'SUCCESS - telebirr bridge found (native ma.startPay)';
      } else if (hasConsumerapp) {
        el.className = 'mx-auto mb-2 px-3 py-2 rounded-lg border text-center text-xs font-semibold bg-green-50 border-green-200 text-green-700';
        el.textContent = 'SUCCESS - telebirr bridge found (consumerapp)';
      } else {
        el.className = 'mx-auto mb-2 px-3 py-2 rounded-lg border text-center text-xs font-semibold bg-red-50 border-red-200 text-red-700';
        el.textContent = 'ERROR - no telebirr bridge. Browser mode, payment will redirect.';
      }

      fetch('/api/diagnostics/bridge', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          hasConsumerapp: hasConsumerapp,
          hasMa: typeof window.ma !== 'undefined' && window.ma !== null,
          hasStartPay: hasStartPay,
          paymentPath: hasStartPay ? 'native ma.startPay' : hasConsumerapp ? 'H5 consumerapp.evaluate' : 'browser redirect',
          userAgent: navigator.userAgent,
          href: location.href
        })
      }).catch(function () {});
    })();

    /**
     * Inside the telebirr SuperApp the bridge object `window.consumerapp` is
     * injected. Its presence is what tells us to run the Mini App (InApp) flow
     * rather than the browser redirect flow.
     */
    function inSuperApp() {
      var hasConsumerapp = typeof window.consumerapp !== 'undefined' && window.consumerapp !== null;
      var hasStartPay = typeof window.ma !== 'undefined' && window.ma && typeof window.ma.startPay === 'function';
      return hasConsumerapp || hasStartPay;
    }

    function resetBtn() {
      const btn = document.getElementById('payBtn');
      const btnText = document.getElementById('payBtnText');
      btn.disabled = false;
      btn.classList.remove('opacity-75', 'cursor-not-allowed');
      btnText.innerText = 'Pay with Telebirr';
    }

    // The SuperApp calls this by name once the PIN sheet closes. It proves
    // nothing about payment, so it only sends us to the page that polls for
    // the real status confirmed by the notify callback.
    window.handleinitDataCallback = function () {
      window.location.href = '/pay/success?orderNo=' + encodeURIComponent(orderNo);
    };

    async function initiatePayment() {
      const btn = document.getElementById('payBtn');
      const btnText = document.getElementById('payBtnText');
      btn.disabled = true;
      btn.classList.add('opacity-75', 'cursor-not-allowed');
      btnText.innerText = inSuperApp() ? 'Opening telebirr...' : 'Redirecting...';

      try {
        if (inSuperApp()) {
          // Mini App path: the server returns a rawRequest STRING, not JSON.
          const res = await fetch('/api/payment/telebirr/miniapp/order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderNo })
          });
          const rawRequest = (await res.text()).trim();

          if (!res.ok || !rawRequest) {
            alert('Could not start payment: ' + (rawRequest || 'unknown error'));
            resetBtn();
            return;
          }

          // Native mini app exposes ma.startPay (see the shop demo). A plain
          // SuperApp webview only has the consumerapp bridge. Prefer native.
          if (typeof window.ma !== 'undefined' && window.ma && typeof window.ma.startPay === 'function') {
            window.ma.startPay({
              rawRequest: rawRequest,
              success: function (res) {
                console.log('startPay result', res && res.resultCode);
                window.handleinitDataCallback();
              },
              fail: function (err) {
                console.error('startPay failed', err);
                alert('Payment could not be started');
                resetBtn();
              }
            });
            return;
          }

          window.consumerapp.evaluate(JSON.stringify({
            functionName: 'js_fun_start_pay',
            params: {
              rawRequest: rawRequest,
              functionCallBackName: 'handleinitDataCallback'
            }
          }));
          return;
        }

        // Browser path: redirect to the hosted checkout page.
        const res = await fetch('/api/payment/telebirr/initiate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderNo })
        });
        const data = await res.json();
        if (data.success && data.toPayUrl) {
          window.location.href = data.toPayUrl;
        } else {
          alert('Error starting Telebirr session: ' + (data.message || 'Unknown error'));
          resetBtn();
        }
      } catch (err) {
        console.error(err);
        alert('Network error connecting to payment gateway');
        resetBtn();
      }
    }

    async function simulateFastCheckout() {
      try {
        // Sandbox-only endpoint (gated by TELE_ALLOW_SANDBOX_PAY). The real
        // Telebirr notify route verifies signatures and rejects this shape.
        await fetch('/api/webhooks/payment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderNo, amount: "<%= price %>", paymentMethod: 'Sandbox' })
        });
        window.location.href = `/pay/success?orderNo=${orderNo}`;
      } catch (err) {
        console.error(err);
      }
    }
  </script>
</body>

</html>